# Copy to .env for local overrides. When you run `eval $(floci env)` these
# AWS_* values are usually set for you by Floci — you only need to set the
# app-specific names and the JWT secret.

# --- AWS / Floci ---
# Floci sets AWS_ENDPOINT_URL via `eval $(floci env)`. Leave unset to hit real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
# Floci accepts any credentials; boto3 just needs them to be present.
AWS_ACCESS_KEY_ID=floci
AWS_SECRET_ACCESS_KEY=floci

# --- Resource names ---
MENU_TABLE=menu_items
ORDERS_TABLE=orders
ADMINS_TABLE=admins
ORDER_DATE_INDEX=order_date-index
IMAGES_BUCKET=cafe-menu-images

# --- Multi-tenancy ---
# Slug of the default tenant (business code: ^[a-z][a-z0-9_]{1,30}$).
# The default tenant keeps the legacy UNPREFIXED table names above, so
# existing data/tests keep working; every other tenant gets its own
# "{slug}_{base}" tables (e.g. chai_point_orders) created by
# scripts/create_tenant.py — that is the whole migration story to cloud.
DEFAULT_TENANT=main
# Global tenant registry table (PK slug): display name, GSTIN, address,
# phone, bill footer, QR base URL, kitchen printer host per tenant.
TENANTS_TABLE=cafe_tenants

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=12

# --- Seed admin account (used by scripts/seed.py) ---
SEED_ADMIN_USER=owner
SEED_ADMIN_PASSWORD=cafe123

# --- AI recommendations (local Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=25
RECOMMEND_LIMIT=3
RECOMMEND_CACHE_TTL=120
POPULAR_DAYS=7

# --- Cafe identity (printed on bills / receipts) ---
CAFE_NAME=Cafe POS Demo
CAFE_ADDRESS=12 MG Road, Ahmedabad, Gujarat 380001
CAFE_GSTIN=24ABCDE1234F1Z5
CAFE_PHONE=+91 98765 43210

# --- Thermal ESC/POS printer (empty host = dry-run: build bytes, send nothing) ---
ESCPOS_PRINTER_HOST=
ESCPOS_PRINTER_PORT=9100
# 1 = send a KOT to the printer automatically whenever an order is created
# (best-effort: needs ESCPOS_PRINTER_HOST; failures are logged, never raised).
AUTO_PRINT_KOT=0

# --- QR table ordering (public self-order, no auth) ---
# Base URL encoded into the table QR codes: "{QR_BASE_URL}/table/<n>".
QR_BASE_URL=http://localhost:9999

# --- Loyalty points ---
LOYALTY_TABLE=loyalty_accounts
# Points earned per ₹1 of paid amount.
LOYALTY_EARN_RATE=1
# Value of one point in paise (100 => 1 point = ₹1).
LOYALTY_POINT_VALUE_PAISE=100

# --- Delivery partner ingestion (X-Integration-Key header, dev defaults) ---
# Rotate these in production; an empty value rejects every request.
SWIGGY_API_KEY=dev-swiggy-key
ZOMATO_API_KEY=dev-zomato-key

# --- Offline-first sync (POST /sync/batch) ---
# Max operations an offline client may replay in a single batch.
SYNC_MAX_BATCH=50
