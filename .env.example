# Copy to .env (repo root) — docker compose reads it automatically.
# Everything here is optional; with no .env you get a fully working local stack.

# --- Cloudflare tunnel ---
# Quick demo URL (random *.trycloudflare.com):
#   docker compose --profile tunnel up -d tunnel
#   -> copy the https://... URL from `docker compose logs tunnel`
# Stable URL: paste your named-tunnel token (Cloudflare dashboard -> Zero Trust
# -> Networks -> Tunnels -> your tunnel -> Install -> token), then:
#   docker compose --profile tunnel-token up -d named-tunnel
TUNNEL_TOKEN=

# --- Ports on this machine ---
#FLOCI_PORT=4566
#BACKEND_PORT=9999

# --- AWS / Floci ---
# Defaults use the bundled Floci emulator service. To talk to real AWS instead,
# set AWS_ENDPOINT_URL= (empty!) plus real creds below.
#AWS_ENDPOINT_URL=http://floci:4566
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=test
#AWS_SECRET_ACCESS_KEY=test

# --- Auth ---
# REQUIRED in production: a long random secret that signs login tokens.
# Generate one: python3 -c "import secrets;print(secrets.token_hex(32))"
# Leaving this empty falls back to docker-compose's public default
# "dev-secret-change-me", which would let anyone forge tokens.
JWT_SECRET=
#JWT_TTL_HOURS=12

# --- Platform admin (the all-cafes dashboard login) ---
# Empty password = the admin login is disabled.
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=

# --- CORS: browser origins allowed to call the API cross-origin ---
# Comma-separated exact origins (scheme://host[:port]). Only browser/web
# access cares — the native iOS app ignores CORS entirely.
#CORS_ORIGINS=https://mobileapp.unonomercysound.online,http://localhost:9999

# --- AI features: Ollama stays on the host (models live there); the backend
# container reaches it via host-gateway ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- First-boot seed logins (printed in `docker compose logs backend`) ---
#SEED_ADMIN_USER=owner
#SEED_ADMIN_PASSWORD=cafe123

# Set SEED_ON_START=0 to boot against existing data without seeding checks.
#SEED_ON_START=1
