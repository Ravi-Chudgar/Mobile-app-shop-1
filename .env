# Copy to .env (repo root) — docker compose reads it automatically.
# Everything here is optional; with no .env you get a fully working local stack.

# --- Cloudflare tunnel ---
# Quick demo URL (random *.trycloudflare.com):
#   docker compose --profile tunnel up -d tunnel
#   -> copy the https://... URL from `docker compose logs tunnel`
# Stable URL: paste your named-tunnel token (Cloudflare dashboard -> Zero Trust
# -> Networks -> Tunnels -> your tunnel -> Install -> token), then:
#   docker compose --profile tunnel-token up -d named-tunnel
#
# To get a STATIC URL:
# 1. Go to https://one.dash.cloudflare.com/ → Networks → Tunnels
# 2. Create a tunnel named "mobile-app-shop"
# 3. Add a public hostname: "mobileapp.unonomercysound.online" → http://backend:9999
# 4. Copy the tunnel token and paste it below
TUNNEL_TOKEN=eyJhIjoiZWY2NjNhZTViZTk3MzAyMjFlOWQ0ODBjMTFkZWI2YTQiLCJ0IjoiZjY5NzU4NjgtZWQxMS00YjJjLWE2YWQtMjJmMDBjM2RlZTIxIiwicyI6Ik1qZ3hPVEZtWkRrdE1EQTNaUzAwT0dReUxXRTBaV1V0WWpneU9EWmhZbVEzTURneFlqQXpaRGRqWkdFdE9XTTBZeTAwTURnd0xUazNOV1F0TnpsaFlqbGxObU5rT1RNMyJ9

# --- Your static tunnel URL (update after creating the tunnel) ---
CLOUDFLARE_TUNNEL_URL=https://mobileapp.unonomercysound.online

# --- Ports on this machine ---
#FLOCI_PORT=4566
#BACKEND_PORT=9999

# --- AWS / Floci ---
# Defaults use the bundled Floci emulator service. To talk to real AWS instead,
# set AWS_ENDPOINT_URL= (empty!) plus real creds below.
#AWS_ENDPOINT_URL=http://floci:4566
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=test
#AWS_SECRET_ACCESS_KEY=test

# --- Auth ---
#JWT_SECRET=change-me-in-prod
#JWT_TTL_HOURS=12

# --- AI features: Ollama stays on the host (models live there); the backend
# container reaches it via host-gateway ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- First-boot seed logins (printed in `docker compose logs backend`) ---
#SEED_ADMIN_USER=owner
#SEED_ADMIN_PASSWORD=cafe123

# Set SEED_ON_START=0 to boot against existing data without seeding checks.
#SEED_ON_START=1

# --- Thermal printer (ESC/POS over TCP) ---
# Find the printer's IP: power it on while holding the FEED button (prints a
# network/config page), or check your router's connected devices.
# Leave ESCPOS_PRINTER_HOST empty for dry-run (no physical printing).
#ESCPOS_PRINTER_HOST=192.168.1.50
#ESCPOS_PRINTER_PORT=9100
# Auto-send a KOT to the kitchen printer when an order is placed:
#AUTO_PRINT_KOT=1
